# ---------- APP ----------
NODE_ENV=development
PORT=1310
HOST=0.0.0.0
# true only when running behind nginx / load balancer (for correct client IP)
TRUST_PROXY=false
LOG_LEVEL=info
# pino logs -> <LOG_DIR>/app.YYYY-MM-DD.1.log (everything) + error.YYYY-MM-DD.1.log (only errors), kept LOG_RETENTION_DAYS days
LOG_DIR=logs
LOG_RETENTION_DAYS=7
# "request completed" line with time taken for every request, slower than SLOW_REQUEST_MS = "slow": true
REQUEST_LOG_ENABLED=true
SLOW_REQUEST_MS=1000
BODY_LIMIT_MB=10
CORS_URLS=http://localhost:3000,http://localhost:5173

# ---------- DATABASE (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backend_skeleton
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10
DB_LOGGING=false

# run public + tenant migrations automatically on server start / pm2 restart
RUN_MIGRATIONS_ON_START=true

# ---------- AUTH ----------
JWT_ACCESS_SECRET=change_me_long_random_string
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_SECRET=change_me_long_random_string
JWT_REFRESH_EXPIRY=7d

# first super admin (created by public seeder on first start)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=

# ---------- RATE LIMIT ----------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
